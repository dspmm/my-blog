# 复制为 .env 后填入真实值（切勿提交 .env 到 Git）

# MySQL 连接配置
DB_HOST=172.17.0.1
DB_PORT=3306
DB_NAME=my_blog
DB_USER=blog_app
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# MinIO 对象存储配置
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_ROOT_PASSWORD
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_URL=/my-blog
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_STRONG_MINIO_SECRET_KEY
MINIO_BUCKET_NAME=my-blog

# SMTP 邮件服务配置（用于注册验证码）
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=CHANGE_ME_SMTP_EMAIL
MAIL_PASSWORD=CHANGE_ME_SMTP_AUTH_CODE

# 仅本地调试时可开启；SMTP 不可用时会把验证码写入日志。生产环境必须保持 false。
APP_AUTH_LOG_VERIFICATION_CODE=false

# JWT 签名密钥（至少 32 位高强度随机串，可通过 openssl rand -base64 48 生成）
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM_JWT_SECRET

# 可选：仅用于全新空库初始化管理员/演示账号，线上已有账号时留空即可
INIT_ADMIN_PASSWORD=
INIT_ADMIN_EMAIL=
INIT_DEMO_USER_PASSWORD=
